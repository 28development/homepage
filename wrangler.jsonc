{
  // Static site on Cloudflare Workers: `npm run deploy` builds and uploads ./dist.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umut-tufanoglu-portfolio",
  "account_id": "3e56474836f336293d49dfef2662b243",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "umuttufanoglu.dev", "custom_domain": true },
    { "pattern": "www.umuttufanoglu.dev", "custom_domain": true }
  ]
}
