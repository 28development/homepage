---
import { site } from '../content/site';
import T from './T.astro';
const { experience } = site;
---
<section class="xp band" id="erfahrung" aria-labelledby="xp-title">
  <h2 class="head xp__title" id="xp-title" data-reveal="mask"><span>{experience.heading}<span class="dot">.</span></span></h2>

  <div class="grid xp__body">
    <div class="xp__stations">
      <h3 class="label muted" data-reveal>{experience.stationsLabel}</h3>
      <ol>
        {experience.stations.map((station, index) => (
          <li class="xp__station" data-reveal style={`--i:${Math.min(index, 6)}`}>
            <span class="xp__period label"><T value={station.period} /></span>
            <span class="xp__role">
              <strong><T value={station.role} /></strong>
              <span class="muted"><T value={station.organisation} /></span>
            </span>
            <span class="xp__place small muted">{station.place && <T value={station.place} />}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="xp__skills">
      <h3 class="label muted" data-reveal>{experience.skillsLabel}</h3>
      <dl>
        {experience.skills.map((group, index) => (
          <div class="xp__skill" data-reveal style={`--i:${index + 1}`}>
            <dt class="label muted">{group.label}</dt>
            <dd><ul>{group.items.map((item) => <li class="chip"><T value={item} /></li>)}</ul></dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .xp__title {
    max-width: 14ch;
    margin-bottom: clamp(48px, 6vw, 96px);
  }

  .xp__body {
    row-gap: 72px;
    align-items: start;
  }

  .xp h3 {
    margin-bottom: 8px;
  }

  .xp__stations {
    grid-column: 1 / span 7;
  }

  .xp__skills {
    grid-column: 9 / -1;
  }

  .xp__station {
    display: grid;
    grid-template-columns: 7.5em minmax(0, 1fr) auto;
    gap: 16px;
    align-items: baseline;
    padding-block: 18px;
    box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--field-ink) 20%, transparent);
    transition: padding-left 320ms var(--ease-out);
  }

  .xp__station:hover {
    padding-left: 10px;
  }

  .xp__period {
    letter-spacing: 0.08em;
  }

  .xp__role {
    display: grid;
    gap: 2px;
  }

  .xp__role strong {
    font-size: var(--step-lead);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .xp__place {
    text-align: right;
  }

  .xp__skills dl {
    display: grid;
    gap: 26px;
    margin-top: 18px;
  }

  .xp__skill dd {
    margin-top: 10px;
  }

  .xp__skill ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 900px) {
    .xp__skills,
    .xp__stations {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .xp__station {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .xp__period {
      grid-column: 1 / -1;
    }
  }
</style>
