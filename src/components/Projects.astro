---
import { site, isTodo } from '../content/site';
import ProjectBlock from './ProjectBlock.astro';
const { projects } = site;
const open = projects.items.some((item) =>
  [item.title, item.year, item.summary, item.contribution, item.result, ...item.stack].some(isTodo),
);
---
<section class="projects band" id="projekte" aria-labelledby="projekte-title">
  <div class="projects__top grid">
    <h2 class="head" id="projekte-title" data-reveal="mask"><span>{projects.heading}<span class="dot">.</span></span></h2>
    {open && <p class="projects__notice small" data-reveal style="--i:2"><mark class="todo">{projects.notice}</mark></p>}
  </div>
  <div class="projects__list">
    {projects.items.map((project, index) => <ProjectBlock project={project} flip={index % 2 === 1} />)}
  </div>
</section>

<style>
  .projects__top {
    align-items: end;
    row-gap: 24px;
    margin-bottom: clamp(48px, 6vw, 96px);
  }

  .projects__top .head {
    grid-column: 1 / span 8;
  }

  .projects__notice {
    grid-column: 9 / -1;
    line-height: 1.7;
  }

  .projects__list {
    display: grid;
    gap: clamp(72px, 9vw, 136px);
  }

  @media (max-width: 900px) {
    .projects__top .head,
    .projects__notice {
      grid-column: 1 / -1;
    }
  }
</style>
