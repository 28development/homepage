---
import { site } from '../content/site';
import { avatar } from '../content/portrait';
---
<header class="site-header" data-header>
  <a class="site-header__brand label" href="#top" aria-label={`${site.name.full}, zum Seitenanfang`}>
    {avatar ? (
      <img class="site-header__avatar" src={avatar.src} alt="" width="32" height="32" decoding="async" />
    ) : (
      <svg viewBox="0 0 18 14" width="18" height="14" aria-hidden="true"><path d="M1 5v4M5 2v10M9 0v14M13 3v8M17 5v4" stroke="currentColor" stroke-width="2" fill="none"/></svg>
    )}
    <span>{site.name.full}</span>
  </a>
  <nav class="site-header__nav" aria-label="Hauptnavigation">
    <ul>
      {site.nav.map((item) => (
        <li><a class="site-header__link" href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: var(--inset) var(--inset) auto var(--inset);
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--gutter);
    padding: calc(var(--pad) - 6px) var(--pad);
    color: var(--ink);
    opacity: var(--header-fade, 1);
  }

  .site-header.is-pinned {
    opacity: 1;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 32px;
  }

  .site-header__avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    box-shadow: 0 0 0 2px var(--accent);
  }

  .site-header__brand svg {
    color: var(--accent);
  }

  .site-header ul {
    display: flex;
    gap: clamp(14px, 2vw, 30px);
  }

  .site-header__link {
    position: relative;
    display: block;
    padding: 6px 0;
    font-size: 15px;
    font-weight: 500;
  }

  .site-header__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 360ms var(--ease-out);
  }

  .site-header__link:hover::after,
  .site-header__link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  /* On the way back up the page the header returns as a floating bar. */
  .site-header.is-pinned {
    position: fixed;
    inset: var(--inset) var(--inset) auto var(--inset);
    padding-block: 10px;
    border-radius: 999px;
    background: var(--bg);
    transform: translateY(-160%);
    transition: transform 460ms var(--ease-out);
  }

  .site-header.is-pinned.is-shown {
    transform: none;
  }

  html[data-motion='reduced'] .site-header.is-pinned {
    transition: none;
  }

  @media (max-width: 640px) {
    .site-header__brand span {
      display: none;
    }
    .site-header ul {
      gap: 14px;
    }
    .site-header__link {
      font-size: 14px;
    }
  }

  @media (max-width: 480px) {
    .site-header {
      justify-content: center;
    }
    .site-header__brand {
      display: none;
    }
  }
</style>
