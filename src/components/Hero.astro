---
/** The poster: the photograph stands between the two lines of the name, first name behind it, surname in front. */
import { site } from '../content/site';
import { stats } from '../content/stats';
import { portrait } from '../content/portrait';
import Arrow from './Arrow.astro';
const { hero, name } = site;
---
<section class="hp card" id="top" data-hero aria-labelledby="hero-name">
  <span class="ticks" aria-hidden="true"></span>

  <h1 class="hp__name display" id="hero-name">
    <span class="hp__line hp__line--back" data-reveal="mask"><span>{name.first}</span></span>{' '}
    <span class="hp__line hp__line--front" data-reveal="mask" style="--i:2"><span>{name.last}<span class="dot">.</span></span></span>
  </h1>

  <figure class="hp__photo" data-reveal style="--i:1">
    {portrait && <img src={portrait.src} alt={portrait.alt} width={portrait.width} height={portrait.height} fetchpriority="high" decoding="async" />}
    <svg class="hp__orbit" viewBox="0 0 600 300" aria-hidden="true">
      <ellipse cx="300" cy="150" rx="292" ry="118" fill="none" stroke="currentColor" stroke-width="3" />
      <circle class="hp__moon" r="13" fill="currentColor" />
    </svg>
    <span class="pill hp__tag">{hero.tag}</span>
  </figure>

  <div class="hp__intro">
    <p class="hp__lead" data-reveal style="--i:3">{hero.lead}</p>
    <p class="hp__actions" data-reveal style="--i:4">
      <a class="button" href={hero.primary.href}>{hero.primary.label}<Arrow direction="down" /></a>
      <a class="link" href={hero.secondary.href}>{hero.secondary.label}</a>
    </p>
  </div>

  <dl class="hp__stats">
    {stats.map((stat, index) => (
      <div data-reveal style={`--i:${5 + index}`}>
        <dd><span class="hp__figure" data-count={stat.value}>{stat.value}</span>{stat.unit && <span class="hp__unit">{stat.unit}</span>}</dd>
        <dt class="label">{stat.label}</dt>
      </div>
    ))}
  </dl>
</section>

<style>
  .hp {
    isolation: isolate;
    min-height: calc(100svh - var(--inset) * 2);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto 1fr auto;
    column-gap: var(--gutter);
    padding-top: clamp(72px, 9vh, 104px);
    overflow: clip;
    container-type: inline-size;
  }

  .hp__name {
    grid-column: 1 / -1;
    grid-row: 1;
    font-size: 20.6cqw;
    letter-spacing: -0.06em;
    line-height: 0.84;
  }

  .hp__line {
    position: relative;
    display: block;
    width: max-content;
    padding-bottom: 0.06em;
  }

  /* First name behind the photograph, surname in front of it. */
  .hp__line--back {
    z-index: 1;
  }

  .hp__line--front {
    z-index: 3;
  }

  .hp__photo {
    position: absolute;
    z-index: 2;
    left: 55%;
    top: clamp(64px, 8vh, 96px);
    width: 25cqw;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    background: var(--surface);
    rotate: 3deg;
  }

  .hp__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
    filter: grayscale(1) contrast(1.08);
    mix-blend-mode: multiply;
  }

  .hp__orbit {
    position: absolute;
    left: -70%;
    top: 30%;
    width: 240%;
    color: var(--accent);
    rotate: -14deg;
    pointer-events: none;
    overflow: visible;
  }

  /* A satellite travels the orbit; without motion it rests on it. */
  .hp__moon {
    offset-path: path('M8,150 a292,118 0 1,0 584,0 a292,118 0 1,0 -584,0');
    offset-distance: 32%;
    offset-rotate: 0deg;
  }

  :global(html[data-motion='full']) .hp__moon {
    animation: hp-orbit 11s linear infinite;
  }

  @keyframes hp-orbit {
    from {
      offset-distance: 0%;
    }
    to {
      offset-distance: 100%;
    }
  }

  /* The photograph leans a little towards the pointer. */
  :global(html[data-motion='full']) .hp__photo {
    translate: calc(var(--px, 0) * -16px) calc(var(--py, 0) * -12px);
    transition: translate 700ms var(--ease-out);
  }

  :global(html[data-motion='full']) .hp__tag {
    animation: hp-bob 6s ease-in-out infinite;
  }

  @keyframes hp-bob {
    0%,
    100% {
      translate: 0 -5px;
    }
    50% {
      translate: 0 5px;
    }
  }

  .hp__tag {
    position: absolute;
    right: -18%;
    top: 9%;
    rotate: -10deg;
  }

  .hp__intro {
    grid-column: 1 / span 5;
    grid-row: 3;
    align-self: end;
    position: relative;
    z-index: 4;
  }

  .hp__lead {
    max-width: 40ch;
    font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.25rem);
    line-height: 1.38;
  }

  .hp__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
    margin-top: 18px;
    font-weight: 500;
  }

  .hp__stats {
    grid-column: 7 / -1;
    grid-row: 3;
    align-self: end;
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(20px, 3vh, 40px);
  }

  .hp__stats > div {
    padding: 4px 0 0 clamp(14px, 2vw, 32px);
    box-shadow: inset 1px 0 0 color-mix(in srgb, var(--ink) 22%, transparent);
  }

  .hp__stats dd {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .hp__figure {
    font-size: clamp(2.25rem, 1.4rem + 3vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .hp__unit {
    font-size: var(--step-lead);
    font-weight: 500;
  }

  .hp__stats dt {
    margin-top: 8px;
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .hp {
      padding-top: 84px;
    }
    .hp__name {
      font-size: 20cqw;
    }
    .hp__photo {
      position: relative;
      grid-column: 3 / -1;
      grid-row: 2;
      left: auto;
      top: auto;
      width: 100%;
      margin-block: -6cqw 28px;
    }
    .hp__tag {
      right: -4%;
      top: 7%;
    }
    .hp__orbit {
      left: -46%;
      top: 34%;
      width: 150%;
    }
    .hp__intro,
    .hp__stats {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .hp__stats > div:first-child {
      padding-left: 0;
      box-shadow: none;
    }
  }
</style>
